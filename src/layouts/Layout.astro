---
/**
 * Layout.astro - Shared layout for all pages
 * Props: title (string), description (string)
 */
interface Props {
  title: string;
  description?: string;
}

const { title, description = "A comprehensive clinical concept map builder and reference tool for nursing students." } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} | Clinical Concept Map</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Serif+Display&display=swap" rel="stylesheet" />
  <style is:global>
    :root {
      --color-bg:        #F8F7F4;
      --color-primary:   #1B4F72;
      --color-accent:    #2E86AB;
      --color-highlight: #E8A838;
      --color-text:      #1A1A1A;
      --color-step-1:    #2E86AB;
      --color-step-2:    #1A9E8F;
      --color-step-3:    #E8A838;
      --color-step-4:    #3A7D44;
      --color-step-5:    #C0533A;
      --color-critical:  #C0392B;
      --color-warning:   #E67E22;
      --color-tip:       #2980B9;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--color-bg);
      color: var(--color-text);
      line-height: 1.6;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    h1, h2, h3, h4 { font-family: 'DM Serif Display', serif; line-height: 1.2; }

    main { flex: 1; }

    a { color: var(--color-accent); text-decoration: none; }
    a:hover { text-decoration: underline; }

    /* Cards */
    .card {
      background: #fff;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      padding: 1.5rem;
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.6rem 1.2rem;
      border-radius: 6px;
      border: none;
      cursor: pointer;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.95rem;
      font-weight: 500;
      transition: opacity 0.15s, transform 0.1s;
      text-decoration: none;
    }
    .btn:hover { opacity: 0.9; transform: translateY(-1px); text-decoration: none; }
    .btn-primary { background: var(--color-primary); color: #fff; }
    .btn-accent  { background: var(--color-accent); color: #fff; }
    .btn-outline { background: transparent; border: 2px solid var(--color-primary); color: var(--color-primary); }
    .btn-sm      { padding: 0.4rem 0.8rem; font-size: 0.85rem; }

    /* Tutorial trigger */
    .tutorial-trigger {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0.25rem 0.65rem;
      border-radius: 20px;
      border: none;
      background: #EBF5FB;
      border-left: 3px solid var(--color-accent);
      color: var(--color-accent);
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.15s, transform 0.1s;
      vertical-align: middle;
      font-family: 'DM Sans', sans-serif;
    }
    .tutorial-trigger:hover { background: #D6EAF8; transform: scale(1.03); }
    .tutorial-trigger .tutorial-icon { font-weight: 700; font-size: 0.85rem; }
    .tutorial-trigger.warning { border-left-color: var(--color-warning); color: var(--color-warning); background: #FEF9E7; }
    .tutorial-trigger.critical { border-left-color: var(--color-critical); color: var(--color-critical); background: #FDEDEC; }

    /* Tutorial lightbox */
    .tutorial-overlay {
      display: none;
      position: fixed; inset: 0;
      background: rgba(0,0,0,0.5);
      z-index: 1000;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }
    .tutorial-overlay.active { display: flex; animation: fadeIn 0.15s ease; }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

    .tutorial-modal {
      background: #fff;
      border-radius: 10px;
      width: 100%;
      max-width: 680px;
      max-height: 80vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      box-shadow: 0 8px 32px rgba(0,0,0,0.18);
    }
    .tutorial-header {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      padding: 1.25rem 1.5rem;
      border-bottom: 1px solid #eee;
      flex-shrink: 0;
    }
    .tutorial-category-badge {
      font-size: 0.7rem;
      font-weight: 700;
      color: #fff;
      padding: 0.2rem 0.6rem;
      border-radius: 4px;
      white-space: nowrap;
      margin-top: 0.25rem;
    }
    .tutorial-title {
      flex: 1;
      font-size: 1.15rem;
      line-height: 1.3;
    }
    .tutorial-close {
      background: none;
      border: none;
      font-size: 1.2rem;
      cursor: pointer;
      color: #666;
      flex-shrink: 0;
      padding: 0.1rem 0.4rem;
      border-radius: 4px;
    }
    .tutorial-close:hover { background: #f0f0f0; }
    .tutorial-body {
      overflow-y: auto;
      padding: 1.25rem 1.5rem;
      flex: 1;
      font-size: 0.95rem;
      line-height: 1.7;
    }
    .tutorial-body h3 { margin: 1rem 0 0.5rem; font-size: 1rem; }
    .tutorial-body p  { margin-bottom: 0.75rem; }
    .tutorial-body ul, .tutorial-body ol { margin: 0.5rem 0 0.75rem 1.5rem; }
    .tutorial-body li { margin-bottom: 0.3rem; }
    .tutorial-body table { width: 100%; border-collapse: collapse; margin: 0.75rem 0; font-size: 0.88rem; }
    .tutorial-body th, .tutorial-body td { padding: 7px 10px; border: 1px solid #e0e0e0; text-align: left; }
    .tutorial-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.75rem 1.5rem;
      border-top: 1px solid #eee;
      flex-shrink: 0;
    }
    #tutorial-source { font-size: 0.8rem; color: #888; font-style: italic; }
    .tutorial-close-btn {
      background: var(--color-accent);
      color: #fff;
      border: none;
      border-radius: 6px;
      padding: 0.4rem 1.1rem;
      cursor: pointer;
      font-weight: 600;
      font-family: 'DM Sans', sans-serif;
    }
    .tutorial-close-btn:hover { opacity: 0.9; }

    @media (max-width: 640px) {
      .tutorial-modal { max-height: 100vh; border-radius: 0; }
      .tutorial-overlay { padding: 0; }
    }

    /* Footer */
    footer {
      background: var(--color-primary);
      color: rgba(255,255,255,0.85);
      text-align: center;
      padding: 1.5rem 1rem;
      font-size: 0.9rem;
    }
    footer a { color: var(--color-highlight); }

    /* Back to top */
    #back-to-top {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      background: var(--color-primary);
      color: #fff;
      border: none;
      border-radius: 50%;
      width: 44px;
      height: 44px;
      font-size: 1.2rem;
      cursor: pointer;
      display: none;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 8px rgba(0,0,0,0.2);
      z-index: 500;
      transition: opacity 0.2s;
    }
    #back-to-top.visible { display: flex; }

    /* Fade-in on scroll */
    .fade-in { opacity: 0; transform: translateY(20px); transition: opacity 0.5s, transform 0.5s; }
    .fade-in.visible { opacity: 1; transform: none; }

    /* Tip / Warning / Critical boxes */
    .tip-box {
      border-radius: 8px;
      padding: 1rem 1.25rem;
      margin: 1rem 0;
      border-left: 4px solid;
      font-size: 0.95rem;
    }
    .tip-box.tip      { border-color: var(--color-tip); background: #EBF5FB; }
    .tip-box.warning  { border-color: var(--color-warning); background: #FEF9E7; }
    .tip-box.critical { border-color: var(--color-critical); background: #FDEDEC; }
    .tip-box strong   { display: block; margin-bottom: 0.3rem; }

    @media print {
      nav, footer, #back-to-top, .tutorial-trigger, .tutorial-overlay, .no-print { display: none !important; }
      body { background: #fff; }
      .card { box-shadow: none; border: 1px solid #ddd; }
    }
  </style>
</head>
<body>
  <!-- Navbar -->
  <nav style="background:var(--color-primary);position:sticky;top:0;z-index:900;box-shadow:0 2px 8px rgba(0,0,0,0.15);">
    <div style="max-width:1200px;margin:0 auto;padding:0 1rem;display:flex;align-items:center;justify-content:space-between;height:60px;">
      <a href={`${base}`} style="color:#fff;font-family:'DM Serif Display',serif;font-size:1.2rem;text-decoration:none;white-space:nowrap;">
        🩺 Clinical Concept Map
      </a>
      <button id="nav-hamburger" aria-label="Toggle menu" style="display:none;background:none;border:none;color:#fff;font-size:1.6rem;cursor:pointer;">☰</button>
      <ul id="nav-links" style="list-style:none;display:flex;gap:0.25rem;align-items:center;margin:0;padding:0;">
        <li><a href={`${base}`} class="nav-link">Home</a></li>
        <li><a href={`${base}how-to-use`} class="nav-link">How to Use</a></li>
        <li style="position:relative;" class="nav-dropdown-wrap">
          <a href={`${base}case-studies`} class="nav-link" id="cs-toggle">Case Studies ▾</a>
          <ul class="nav-dropdown" id="cs-dropdown" style="display:none;position:absolute;top:calc(100%+8px);left:0;background:#fff;border-radius:8px;box-shadow:0 4px 16px rgba(0,0,0,0.15);list-style:none;min-width:220px;padding:0.5rem 0;z-index:999;">
            <li><a href={`${base}case-studies/pneumonia`} class="nav-dd-link">Pneumonia (CAP)</a></li>
            <li><a href={`${base}case-studies/chf`} class="nav-dd-link">CHF — Decompensated</a></li>
            <li><a href={`${base}case-studies/sepsis`} class="nav-dd-link">Sepsis (UTI Source)</a></li>
            <li><a href={`${base}case-studies/copd`} class="nav-dd-link">COPD Exacerbation</a></li>
            <li><a href={`${base}case-studies/parkinsons`} class="nav-dd-link">Parkinson's Disease</a></li>
          </ul>
        </li>
        <li><a href={`${base}builder`} class="nav-link nav-builder">Builder</a></li>
      </ul>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer>
    <p>Clinical Concept Map Builder — A teaching tool for nursing students &nbsp;|&nbsp; <a href={`${base}builder`}>Open Builder →</a></p>
  </footer>

  <button id="back-to-top" aria-label="Back to top">↑</button>

  <!-- Tutorial Lightbox Overlay -->
  <div id="tutorial-overlay" class="tutorial-overlay" role="dialog" aria-modal="true" aria-labelledby="tutorial-title">
    <div class="tutorial-modal">
      <div class="tutorial-header">
        <span class="tutorial-category-badge" id="tutorial-category"></span>
        <h2 class="tutorial-title" id="tutorial-title"></h2>
        <button class="tutorial-close" aria-label="Close tutorial">✕</button>
      </div>
      <div class="tutorial-body" id="tutorial-body"></div>
      <div class="tutorial-footer">
        <span id="tutorial-source"></span>
        <button class="tutorial-close-btn">Got it</button>
      </div>
    </div>
  </div>

  <!-- JS Bundles -->
  <script src={`${base}scripts/tutorials.js`} is:inline></script>
  <script src={`${base}scripts/lightbox.js`} is:inline></script>

  <style>
    .nav-link {
      color: rgba(255,255,255,0.9);
      text-decoration: none;
      padding: 0.4rem 0.7rem;
      border-radius: 6px;
      font-weight: 500;
      font-size: 0.95rem;
      transition: background 0.15s;
    }
    .nav-link:hover { background: rgba(255,255,255,0.15); text-decoration: none; }
    .nav-builder { background: var(--color-highlight); color: var(--color-primary) !important; font-weight: 700; }
    .nav-builder:hover { opacity: 0.9; background: var(--color-highlight); }
    .nav-dd-link {
      display: block;
      padding: 0.5rem 1rem;
      color: var(--color-text);
      font-size: 0.9rem;
    }
    .nav-dd-link:hover { background: #f0f4f8; text-decoration: none; }

    @media (max-width: 768px) {
      #nav-hamburger { display: block !important; }
      #nav-links {
        display: none;
        flex-direction: column;
        position: absolute;
        top: 60px;
        left: 0; right: 0;
        background: var(--color-primary);
        padding: 1rem;
        gap: 0.5rem;
        align-items: flex-start;
      }
      #nav-links.open { display: flex; }
      .nav-dropdown-wrap { width: 100%; }
      .nav-link { width: 100%; }
      .nav-dropdown {
        position: static !important;
        box-shadow: none !important;
        background: rgba(255,255,255,0.1) !important;
        margin-top: 0.25rem;
        border-radius: 6px !important;
      }
      .nav-dd-link { color: rgba(255,255,255,0.9) !important; }
      .nav-dd-link:hover { background: rgba(255,255,255,0.1) !important; }
    }
  </style>

  <script>
    // Hamburger menu
    const hamburger = document.getElementById('nav-hamburger');
    const navLinks = document.getElementById('nav-links');
    hamburger?.addEventListener('click', () => navLinks?.classList.toggle('open'));

    // Case studies dropdown
    const csToggle = document.getElementById('cs-toggle');
    const csDropdown = document.getElementById('cs-dropdown');
    csToggle?.addEventListener('click', (e) => {
      if (window.innerWidth > 768) {
        e.preventDefault();
        const open = csDropdown?.style.display === 'block';
        csDropdown!.style.display = open ? 'none' : 'block';
      }
    });
    document.addEventListener('click', (e) => {
      if (!csToggle?.contains(e.target as Node) && !csDropdown?.contains(e.target as Node)) {
        if (csDropdown) csDropdown.style.display = 'none';
      }
    });

    // Back to top
    const btt = document.getElementById('back-to-top');
    window.addEventListener('scroll', () => {
      btt?.classList.toggle('visible', window.scrollY > 400);
    });
    btt?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

    // Scroll-triggered fade-in
    const fadeEls = document.querySelectorAll('.fade-in');
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); } });
    }, { threshold: 0.1 });
    fadeEls.forEach(el => io.observe(el));
  </script>
</body>
</html>
