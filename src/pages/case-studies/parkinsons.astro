---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import TutorialTrigger from '../../components/TutorialTrigger.astro';
import TipBox from '../../components/TipBox.astro';
import DiagnosisBlock from '../../components/DiagnosisBlock.astro';
import DataTable from '../../components/DataTable.astro';

const patient = {
  initials: 'W.T.',
  age: 74,
  sex: 'Male',
  admitDx: "Parkinson's Disease — admitted for right hip fracture (fall)",
  hpi: "74-year-old male with 8-year history of Parkinson's Disease (Hoehn-Yahr Stage 3), admitted after mechanical fall at home resulting in right femoral neck fracture. On Carbidopa-Levodopa 25/100 mg TID — last dose at home 7:00 AM; now 10:00 AM with 3-hour delay. Family reports increasing rigidity and 'freezing' since ED arrival. Pre-op assessment. NPO since admission — team incorrectly applied NPO to PD medications.",
  pmh: ["Parkinson's Disease (Hoehn-Yahr Stage 3, 8 years)", 'Hypertension', 'Orthostatic Hypotension', 'Dysphagia (mild — SLP clearance in file)', 'Depression', 'History of aspiration pneumonia (6 months ago)'],
  meds: ['Carbidopa-Levodopa 25/100 mg TID (7am, 12pm, 5pm) — MUST be given on strict schedule', 'Pramipexole 0.5 mg TID', 'Sertraline 50 mg daily', 'Amlodipine 5 mg daily', 'Lisinopril 10 mg daily'],
  allergies: 'Metoclopramide (causes acute dystonia — documented PD worsening), Haloperidol (contraindicated)',
  vitals: {
    'BP (lying)': '136/84 mmHg',
    'BP (standing)': '104/62 mmHg (orthostatic drop)',
    'HR': '78 bpm',
    'RR': '16 breaths/min',
    'SpO₂': '96% on RA',
    'Temp': '37.1°C',
  },
};

const cues = [
  { finding: 'Carbidopa-Levodopa delay', type: 'Objective', value: '3 hours past due — NOW overdue', normalRange: 'Given exactly on schedule', status: 'Critical' },
  { finding: 'Orthostatic BP drop', type: 'Vital', value: 'SBP drops 32 mmHg from lying to standing', normalRange: 'Drop <20 mmHg', status: 'Critical' },
  { finding: 'Rigidity (lead-pipe)', type: 'Objective', value: 'Increasing since ED arrival — worsening "off" state', normalRange: 'Baseline mild rigidity', status: 'Critical' },
  { finding: 'Freezing episodes', type: 'Objective', value: 'Cannot initiate gait when called to transfer', normalRange: 'Baseline occasional freezing', status: 'Abnormal' },
  { finding: 'Dysphagia assessment', type: 'Objective', value: 'Coughing on thin liquids since medication delay', normalRange: 'SLP-cleared at baseline', status: 'Critical' },
  { finding: 'SpO₂', type: 'Vital', value: '96% on RA', normalRange: '≥95%', status: 'Normal' },
  { finding: 'Mental status', type: 'Objective', value: 'Alert, oriented ×4, appropriate but anxious', normalRange: 'Baseline — alert ×4', status: 'Normal' },
  { finding: 'Hip pain', type: 'Subjective', value: '8/10 at right hip, unable to bear weight', normalRange: '—', status: 'Concerning' },
  { finding: 'Fall risk (Morse)', type: 'Objective', value: 'Score 85 (history of falls 25 + IV line 20 + gait 15 + secondary dx 15 + ambulatory aid 10)', normalRange: 'Low risk <25', status: 'Critical' },
] as any[];
---
<CaseStudyLayout
  title="Parkinson's Disease — Acute Hospitalization"
  description="Complete nursing concept map for a 74-year-old male with Parkinson's Disease admitted for hip fracture — medication timing, aspiration risk, fall prevention."
  patient={patient}
>
  <TipBox type="critical" title="CRITICAL: Carbidopa-Levodopa is 3 HOURS OVERDUE">
    NPO orders do NOT apply to Parkinson's medications. A 30–60 minute delay can precipitate severe "off" episodes. A 3-hour delay is causing the current rigidity increase. Notify provider immediately. Administer Carbidopa-Levodopa NOW via alternate route if oral route is unsafe due to dysphagia. Do NOT give antiemetics that block dopamine (Haloperidol, Metoclopramide, Prochlorperazine, Promethazine) — these are documented allergies and clinically contraindicated.
    <TutorialTrigger tutorialKey="parkinsons-hospital" label="Parkinson's Hospital Dangers" variant="critical" />
  </TipBox>

  <section class="case-section card fade-in">
    <div class="step-header" style="border-color:var(--color-step-1);">
      <span class="step-badge" style="background:var(--color-step-1);">1</span>
      <h2>Disease Process & Pathophysiology</h2>
      <TutorialTrigger tutorialKey="pathophysiology-why" label="Why Pathophysiology First?" />
    </div>
    <h3>Mechanism of Parkinson's Disease</h3>
    <p>PD involves progressive degeneration of dopaminergic neurons in the <strong>substantia nigra</strong> of the basal ganglia. Dopamine normally modulates smooth, voluntary motor control. As dopamine depletes:</p>
    <ul>
      <li><strong>Motor symptoms:</strong> Resting tremor, rigidity (lead-pipe or cogwheel), bradykinesia (slow movement), postural instability → TRAP mnemonic</li>
      <li><strong>Gait disturbances:</strong> Festinating gait (short, shuffling steps), freezing episodes (sudden inability to initiate movement)</li>
      <li><strong>Autonomic dysfunction:</strong> Orthostatic hypotension (impaired baroreceptor response), dysphagia (oropharyngeal rigidity)</li>
      <li><strong>The "Off" state:</strong> When Carbidopa-Levodopa levels fall below therapeutic threshold, dopamine replacement is insufficient → motor symptoms worsen dramatically</li>
    </ul>
    <h3 style="margin-top:1rem;">Why Hospitalization Is High Risk for PD Patients</h3>
    <ul>
      <li><strong>Medication timing disruption:</strong> Even 30–60 minutes off-schedule can cause severe "off" episodes; hospital routines frequently cause inadvertent delays</li>
      <li><strong>Dysphagia:</strong> Oropharyngeal rigidity impairs swallowing — aspiration risk is constant; leading cause of PD death is aspiration pneumonia</li>
      <li><strong>Fall risk:</strong> Orthostatic hypotension + gait instability + new environment + pain = extreme fall risk</li>
      <li><strong>Contraindicated medications:</strong> Dopamine-blocking antiemetics are commonly prescribed for nausea post-op and can cause acute PD crisis</li>
    </ul>
    <TipBox type="warning" title="MAR Critical Notes">
      Carbidopa-Levodopa MUST be given at exact scheduled times (7am, 12pm, 5pm) — currently 3 hours overdue. Metoclopramide and Haloperidol are documented allergies due to PD worsening — verify with pharmacy that no standing PRN orders include these drugs. If patient develops nausea post-op: Ondansetron (Zofran) is the safe alternative.
      <TutorialTrigger tutorialKey="medication-high-alert" label="High-Alert Medications" variant="warning" />
    </TipBox>
  </section>

  <section class="case-section card fade-in">
    <div class="step-header" style="border-color:var(--color-step-2);">
      <span class="step-badge" style="background:var(--color-step-2);">2</span>
      <h2>Recognizing Cues</h2>
      <TutorialTrigger tutorialKey="objective-vs-subjective" label="Objective vs. Subjective" />
    </div>
    <DataTable rows={cues} />
    <TipBox type="critical" title="Orthostatic Hypotension — Fall Risk">
      SBP drops 32 mmHg from lying to standing — clinically significant orthostatic hypotension (threshold: ≥20 mmHg drop). This patient should NOT be allowed to stand or walk without assisted standing, gradual position change, and two-person assist. Do not ambulate if SBP &lt;90 or if patient reports dizziness.
      <TutorialTrigger tutorialKey="orthostatic-hypotension" label="Orthostatic Hypotension Guide" variant="critical" />
    </TipBox>
  </section>

  <section class="case-section card fade-in">
    <div class="step-header" style="border-color:var(--color-step-3);">
      <span class="step-badge" style="background:var(--color-step-3);">3</span>
      <h2>Analyzing Cues</h2>
      <TutorialTrigger tutorialKey="supporting-vs-concerning" label="Supporting vs. Concerning" />
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
      <div>
        <h3 style="color:var(--color-step-4);">✓ Supporting Data</h3>
        <ul style="font-size:0.9rem;line-height:1.8;padding-left:1.2rem;">
          <li>Baseline mild rigidity — expected for Hoehn-Yahr Stage 3</li>
          <li>Orthostatic hypotension — known autonomic dysfunction feature of PD</li>
          <li>Occasional freezing — expected at PD Stage 3</li>
          <li>Hip pain — expected from femoral neck fracture</li>
          <li>Mild dysphagia at baseline — expected with 8-year PD</li>
          <li>SpO₂ 96% — normal at baseline</li>
        </ul>
      </div>
      <div>
        <h3 style="color:var(--color-critical);">⚠ Concerning Data</h3>
        <ul style="font-size:0.9rem;line-height:1.8;padding-left:1.2rem;">
          <li><strong>3-hour medication delay</strong> — directly causing worsening rigidity (preventable)</li>
          <li>Increasing lead-pipe rigidity — risk for aspiration as oropharyngeal rigidity worsens</li>
          <li>Dysphagia worsening beyond baseline — aspiration risk; may need NGT for medications</li>
          <li>Morse fall score 85 — highest risk; imminent fall risk in unfamiliar environment</li>
          <li>Orthostatic drop 32 mmHg — much greater than baseline (25 mmHg typical)</li>
          <li>Post-op nausea anticipated — contraindicated antiemetics on default formulary</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="case-section card fade-in">
    <div class="step-header" style="border-color:var(--color-step-4);">
      <span class="step-badge" style="background:var(--color-step-4);">4</span>
      <h2>Prioritizing Hypotheses & Taking Actions</h2>
      <TutorialTrigger tutorialKey="abc-priority" label="ABC Priority" />
      <TutorialTrigger tutorialKey="nanda-format" label="NANDA Format" />
    </div>

    <DiagnosisBlock
      priority={1}
      nanda="Impaired Physical Mobility"
      relatedTo="neuromuscular impairment from Parkinson's disease exacerbated by subtherapeutic Carbidopa-Levodopa level (3-hour medication delay) and right femoral neck fracture"
      aeb="increasing lead-pipe rigidity since medication delay, freezing episode preventing transfer, Morse fall score 85, unable to bear weight on right lower extremity, orthostatic BP drop 32 mmHg"
      color="var(--color-step-1)"
    >
      <h4 style="margin:0.75rem 0 0.4rem;color:var(--color-primary);">SMART Goal</h4>
      <p style="font-size:0.9rem;background:#f0f9f0;padding:0.6rem 0.8rem;border-radius:6px;">Patient will receive Carbidopa-Levodopa within 30 minutes; within 1 hour of dose, patient will demonstrate decreased rigidity as reported by patient and measured by passive range of motion assessment, allowing safe assisted transfer to chair.</p>
      <h4 style="margin:0.75rem 0 0.4rem;color:var(--color-primary);">Interventions</h4>
      <ol style="font-size:0.9rem;line-height:1.9;padding-left:1.2rem;">
        <li><strong>IMMEDIATE:</strong> Notify provider — Carbidopa-Levodopa 3 hours overdue; NPO order does NOT apply to PD medications; obtain verbal order to administer NOW</li>
        <li>If oral route unsafe (dysphagia): consult pharmacy for alternative formulation (ODT available — does not require swallowing) or NG/J-tube administration</li>
        <li>Morse fall score 85 — implement high fall risk protocol: bed in lowest position, all 4 side rails up, call light within reach, bed alarm on, non-slip socks, clear path to bathroom</li>
        <li>Two-person assist required for ALL transfers — patient should not attempt to stand alone</li>
        <li>For freezing episodes: use visual cues (floor tape or laser pointer if available) or rhythmic auditory cues ("1-2-3-step") to help initiate movement</li>
        <li>Physical therapy and occupational therapy consult for mobility assessment post-medication administration</li>
        <li>Keep strict medication schedule: 7am, 12pm, 5pm — set nursing alerts in EHR to prevent future delays</li>
      </ol>
    </DiagnosisBlock>

    <DiagnosisBlock
      priority={2}
      nanda="Risk for Aspiration"
      relatedTo="oropharyngeal rigidity from Parkinson's disease worsened by medication delay, history of aspiration pneumonia, and impaired swallow reflex"
      aeb="coughing on thin liquids since medication delay (worsening from baseline), history of aspiration pneumonia 6 months ago, SLP-cleared at baseline (re-assessment needed given current worsening)"
      color="var(--color-step-2)"
    >
      <h4 style="margin:0.75rem 0 0.4rem;color:var(--color-primary);">SMART Goal</h4>
      <p style="font-size:0.9rem;background:#f0f9f0;padding:0.6rem 0.8rem;border-radius:6px;">Patient will not experience aspiration event as evidenced by absence of coughing/choking during meal, O₂ sat remaining ≥95%, and no new respiratory symptoms; SLP bedside swallow evaluation completed within 4 hours.</p>
      <h4 style="margin:0.75rem 0 0.4rem;color:var(--color-primary);">Interventions</h4>
      <ol style="font-size:0.9rem;line-height:1.9;padding-left:1.2rem;">
        <li>HOLD all oral intake until SLP re-evaluates swallow function (current worsening exceeds baseline SLP clearance)</li>
        <li>Urgent SLP consult for bedside swallow evaluation — given history of aspiration pneumonia and current worsening, this is a priority consult</li>
        <li>If oral route confirmed safe: HOB 90° during all oral intake; chin tuck technique; thickened liquids as ordered</li>
        <li>Monitor for aspiration signs post-PD medication administration: O₂ sat, temperature, chest auscultation</li>
        <li>For medication administration: confirm SLP clearance for pill swallowing OR use ODT/liquid formulations</li>
        <li>Oral hygiene q4h while NPO — reduce bacterial load if microaspiration occurs</li>
        <li>Suction equipment at bedside; staff trained in PD aspiration recognition</li>
      </ol>
    </DiagnosisBlock>

    <DiagnosisBlock
      priority={3}
      nanda="Risk for Falls"
      relatedTo="Parkinson's disease (postural instability, freezing, bradykinesia), orthostatic hypotension (SBP drop 32 mmHg), right femoral neck fracture impairing weight-bearing, and unfamiliar hospital environment"
      aeb="Morse Fall Scale score 85 (high risk ≥45), history of fall resulting in this admission, orthostatic hypotension, freezing episode in ED, unable to bear weight on right lower extremity"
      color="var(--color-step-3)"
    >
      <h4 style="margin:0.75rem 0 0.4rem;color:var(--color-primary);">SMART Goal</h4>
      <p style="font-size:0.9rem;background:#f0f9f0;padding:0.6rem 0.8rem;border-radius:6px;">Patient will remain free from falls throughout hospitalization as evidenced by zero fall incidents; patient will correctly verbalize fall prevention measures (calling for help before getting up) by end of shift.</p>
      <h4 style="margin:0.75rem 0 0.4rem;color:var(--color-primary);">Interventions</h4>
      <ol style="font-size:0.9rem;line-height:1.9;padding-left:1.2rem;">
        <li>Bed in lowest position at all times; all 4 side rails up; bed alarm activated</li>
        <li>Non-slip footwear; ensure path to bathroom is clear and well-lit at night</li>
        <li>Two-person assist for ALL mobility — document in care plan that patient requires two people</li>
        <li>Educate patient and family: DO NOT attempt to stand without calling; demonstrate call light use</li>
        <li>Orthostatic hypotension protocol: dangle legs 2–3 minutes before standing; stand slowly with support; do NOT ambulate if SBP &lt;90 or symptomatic</li>
        <li>Visual cues for freezing: colored tape on floor or laser pointer may help initiate movement if freezing occurs</li>
        <li>Ensure PD medications are always given on time — single most important fall prevention in this patient</li>
        <TutorialTrigger tutorialKey="fall-risk" label="Fall Risk Assessment Guide" />
      </ol>
    </DiagnosisBlock>
  </section>

  <section class="case-section card fade-in">
    <div class="step-header" style="border-color:var(--color-step-5);">
      <span class="step-badge" style="background:var(--color-step-5);">5</span>
      <h2>Evaluating Outcomes</h2>
      <TutorialTrigger tutorialKey="evaluation-evidence" label="Objective Evaluations" />
      <TutorialTrigger tutorialKey="feedback-loop" label="Reassessment Loop" />
    </div>
    <div style="display:grid;gap:1rem;">
      <div class="eval-block" style="border-left:4px solid var(--color-step-4);">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.5rem;">
          <strong>Dx 1: Impaired Physical Mobility</strong>
          <span class="eval-badge partial">Partially Met</span>
        </div>
        <p style="font-size:0.9rem;color:#444;">Carbidopa-Levodopa administered at 10:15 AM after verbal provider order (30 min after nursing identification). By 11:15 AM: patient reports subjective improvement in rigidity ("I feel less stiff"). Passive ROM: decreased lead-pipe resistance. Able to assist with repositioning. Transfer to chair attempted with 2-person assist — patient completed transfer with moderate assist, no freezing. Fall prevention protocol active. Medication schedule alerts set in EHR for 5 PM and 7 AM tomorrow.</p>
      </div>
      <div class="eval-block" style="border-left:4px solid var(--color-step-4);">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.5rem;">
          <strong>Dx 2: Risk for Aspiration</strong>
          <span class="eval-badge partial">Ongoing — No Aspiration Event</span>
        </div>
        <p style="font-size:0.9rem;color:#444;">SLP completed bedside evaluation at 1300: recommended nectar-thick liquids and soft/moist solid foods; approved medications as whole pills with nectar-thick liquid. No aspiration events during shift. O₂ sat stable at 96%. Oral care q4h completed. Coughing on thin liquids improved (less frequent) after Carbidopa-Levodopa dose — consistent with medication effect on oropharyngeal tone.</p>
      </div>
      <div class="eval-block" style="border-left:4px solid var(--color-step-4);">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.5rem;">
          <strong>Dx 3: Risk for Falls</strong>
          <span class="eval-badge met">Met — No Fall Events</span>
        </div>
        <p style="font-size:0.9rem;color:#444;">No fall events during shift. Patient verbalized fall prevention measures correctly: "I'll call before getting up — I know I need two people." Bed alarm active all shift. Orthostatic protocol followed for both transfers. Family educated and reinforcing messaging. All safety measures maintained per fall risk protocol.</p>
      </div>
    </div>
  </section>

  <style>
    .case-section { margin-bottom: 1.75rem; }
    .step-header { display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap;margin-bottom:1rem;padding-bottom:0.75rem;border-bottom:2px solid; }
    .step-header h2 { font-size:1.2rem;color:var(--color-primary);flex:1;min-width:150px; }
    .step-badge { width:32px;height:32px;border-radius:50%;color:#fff;font-weight:700;font-size:0.95rem;display:flex;align-items:center;justify-content:center;flex-shrink:0; }
    h3 { color:var(--color-primary);font-size:1rem;margin-bottom:0.5rem; }
    ul, ol { padding-left:1.5rem;line-height:1.8;color:#444;font-size:0.92rem; }
    h4 { font-size:0.95rem; }
    .eval-block { background:#fafafa;border-radius:6px;padding:0.9rem 1rem; }
    .eval-badge { font-size:0.75rem;font-weight:700;padding:0.2rem 0.7rem;border-radius:12px; }
    .eval-badge.met { background:#27AE60;color:#fff; }
    .eval-badge.partial { background:var(--color-warning);color:#fff; }
    .eval-badge.notmet { background:var(--color-critical);color:#fff; }
  </style>
</CaseStudyLayout>
