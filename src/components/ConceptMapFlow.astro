---
/**
 * ConceptMapFlow.astro - CSS-only 5-step horizontal flow diagram with arrows
 */
const steps = [
  { n: 1, label: 'Recognize Cues', sub: 'Objective & Subjective Data', color: 'var(--color-step-1)' },
  { n: 2, label: 'Analyze Cues', sub: 'Supporting & Concerning', color: 'var(--color-step-2)' },
  { n: 3, label: 'Prioritize', sub: 'Nursing Diagnoses', color: 'var(--color-step-3)' },
  { n: 4, label: 'Take Actions', sub: 'Goals & Interventions', color: 'var(--color-step-4)' },
  { n: 5, label: 'Evaluate', sub: 'Outcomes & Reassessment', color: 'var(--color-step-5)' },
];
---
<div class="flow-container" role="img" aria-label="5-step clinical judgment flow">
  {steps.map((step, i) => (
    <>
      <div class="flow-step" style={`border-color:${step.color};`}>
        <div class="flow-badge" style={`background:${step.color};`}>{step.n}</div>
        <div class="flow-label" style={`color:${step.color};`}>{step.label}</div>
        <div class="flow-sub">{step.sub}</div>
      </div>
      {i < steps.length - 1 && (
        <div class="flow-arrow" aria-hidden="true">→</div>
      )}
    </>
  ))}
</div>

<style>
  .flow-container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    flex-wrap: wrap;
    padding: 1rem 0;
  }
  .flow-step {
    flex: 1;
    min-width: 120px;
    max-width: 180px;
    border: 2px solid;
    border-radius: 8px;
    padding: 1rem 0.75rem;
    text-align: center;
    background: #fff;
    box-shadow: 0 2px 8px rgba(0,0,0,0.07);
    transition: transform 0.15s;
  }
  .flow-step:hover { transform: translateY(-3px); }
  .flow-badge {
    width: 36px; height: 36px;
    border-radius: 50%;
    color: #fff;
    font-weight: 700;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 0.5rem;
  }
  .flow-label { font-weight: 700; font-size: 0.9rem; margin-bottom: 0.2rem; }
  .flow-sub { font-size: 0.75rem; color: #777; }
  .flow-arrow {
    font-size: 1.5rem;
    color: #bbb;
    padding: 0 0.25rem;
    flex-shrink: 0;
  }
  @media (max-width: 640px) {
    .flow-container { gap: 0.5rem; }
    .flow-step { min-width: 90px; padding: 0.75rem 0.5rem; }
    .flow-arrow { font-size: 1rem; }
  }
</style>
