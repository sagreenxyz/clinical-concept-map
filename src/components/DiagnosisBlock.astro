---
/**
 * DiagnosisBlock.astro - Nursing diagnosis block with interventions, SMART goal, and evaluation
 * Props:
 *   priority: number (1-3)
 *   nanda: string - NANDA diagnosis label
 *   relatedTo: string - etiology
 *   aeb: string - as evidenced by
 *   color: string - border/accent color
 */
interface Props {
  priority: number;
  nanda: string;
  relatedTo: string;
  aeb: string;
  color?: string;
}
const { priority, nanda, relatedTo, aeb, color = 'var(--color-step-3)' } = Astro.props;
---
<div class="dx-block card fade-in" style={`border-left:5px solid ${color};`}>
  <div style="display:flex;align-items:baseline;gap:0.75rem;margin-bottom:0.75rem;flex-wrap:wrap;">
    <span class="dx-priority" style={`background:${color};`}>Priority {priority}</span>
    <h3 class="dx-nanda">{nanda}</h3>
  </div>
  <p style="font-size:0.9rem;color:#444;margin-bottom:0.25rem;"><strong>Related to:</strong> {relatedTo}</p>
  <p style="font-size:0.9rem;color:#444;margin-bottom:1rem;"><strong>As evidenced by:</strong> {aeb}</p>
  <slot />
</div>

<style>
  .dx-block { margin-bottom: 1.5rem; }
  .dx-priority {
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .dx-nanda { font-size: 1.05rem; color: var(--color-primary); }
</style>
